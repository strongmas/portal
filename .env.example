APP_NAME=Strongmas
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strongmas_portal
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=strongmas_portal_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Object storage. Setting AWS_BUCKET switches BOTH the "public" and "private"
# disks from the local filesystem to S3/R2 — on container hosting the local
# disk is wiped on every deploy, so a bucket is required in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment proofs, property documents and support attachments. Point this at a
# SEPARATE, non-public bucket — AWS_BUCKET above may be served over a public
# URL, which would expose buyers' bank documents without any login. Falls back
# to AWS_BUCKET when unset (convenient, but not safe if that bucket is public).
AWS_PRIVATE_BUCKET=
AWS_PRIVATE_ACCESS_KEY_ID=
AWS_PRIVATE_SECRET_ACCESS_KEY=

# Shared secret for the read-only MD reports API (/api/md-reports) consumed
# by the external Infiniti/Strongforce dashboard. Must match the token set in
# the Namecheap app's config/portal_api.php.
MD_REPORTS_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Off-site backups (php artisan backup:run, scheduled nightly at 02:00).
# Use a DIFFERENT provider or account from the app's own storage above,
# e.g. Cloudflare R2 or Backblaze B2 under a separate login.
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_ALERT_EMAIL=
BACKUP_KEEP_DAYS=30
